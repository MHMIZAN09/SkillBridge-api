model Category {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  description String?
  icon        String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tutors      TutorCategory[]

  @@map("categories")
}
