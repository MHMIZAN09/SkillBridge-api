model Booking {
  id              String        @id @default(uuid())
  studentId       String
  student         User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Restrict)
  tutorProfileId  String
  tutorProfile    TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  subject         String
  notes           String?       @db.Text
  status          BookingStatus @default(CONFIRMED)
  sessionFormat   SessionFormat @default(ONLINE)
  totalAmount     Decimal       @db.Decimal(10, 2)
  meetingLink     String?
  cancelledBy     CancelledBy?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  review Review?

  @@index([studentId])
  @@index([tutorProfileId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}
